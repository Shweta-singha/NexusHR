          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman-new-employee\",\n  \"password\": \"NewEmployee@2026\",\n  \"email\": \"postman-new-employee@example.com\",\n  \"role\": \"EMPLOYEE\"\n}"
