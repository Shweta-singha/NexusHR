FROM python:3.12-slim AS builder

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# model/attrition_model.joblib is gitignored (Day 6's *.joblib rule - it's a
# build artifact, not source) and was only ever generated by running train.py
# manually on a dev machine. Train it here instead, against the committed
# synthetic_attrition.csv, so the image is self-contained and doesn't depend
# on a locally-generated file existing in the build context - this is what
# broke the first Render deploy attempt (COPY model/ model/ had nothing to
# copy). train_test_split and RandomForestClassifier are both random_state=42
# in train.py, so this build-time run reproduces the same holdout metrics
# every time, not just approximately.
COPY train.py .
COPY data/ data/
RUN python train.py


FROM python:3.12-slim

RUN useradd --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY --from=builder /root/.local /home/appuser/.local
COPY --from=builder /app/model/ model/
COPY main.py .

RUN chown -R appuser:appuser /app
USER appuser

ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
