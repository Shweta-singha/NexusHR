    {
      "name": "Cleanup",
      "description": "Run last, not mid-sequence: Delete Employee and Logout both end a session other folders depend on (Department/Payroll/Reviews all reference employee_id; every request after Logout needs a valid access_token).",
      "item": [
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/employee/delete/{{employee_id}}", "host": ["{{base_url}}"], "path": ["api", "employee", "delete", "{{employee_id}}"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    }
  ]
}
